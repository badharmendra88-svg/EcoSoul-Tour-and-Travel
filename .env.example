# Copy to .env and fill in real values. Never commit .env.

# SQLite file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Public site URL — used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Business contact details (blueprint §21 — owner must provide real values)
NEXT_PUBLIC_PHONE="+910000000000"
NEXT_PUBLIC_WHATSAPP="910000000000"
NEXT_PUBLIC_EMAIL="hello@example.com"
NEXT_PUBLIC_ADDRESS="Service area: Uttarakhand (address to be confirmed)"
NEXT_PUBLIC_HOURS="Mon–Sun, 9:00 am – 8:00 pm IST"

# Admin panel — use a long random password and secret (e.g. `openssl rand -hex 32`)
ADMIN_PASSWORD="change-me-to-a-long-password"
SESSION_SECRET="change-me-to-a-64-char-random-hex-string"

# Optional: internal lead notification webhook (Slack/Google Chat/Zapier/Make etc.)
# Receives { text } JSON. Leave empty to skip notifications.
NOTIFY_WEBHOOK_URL=""

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=""
