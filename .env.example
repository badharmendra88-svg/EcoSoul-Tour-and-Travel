# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL. Neon (Vercel): DATABASE_URL = the pooled connection string (host has "-pooler"),
# DIRECT_URL = the direct one, used by migrations. Locally DATABASE_URL alone is enough.
DATABASE_URL="postgresql://user:password@localhost:5432/ecosoul_travel"
DIRECT_URL=""

# Public site URL — used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3200"

# Business contact details (blueprint §21 — owner must provide real values)
NEXT_PUBLIC_PHONE="+910000000000"
NEXT_PUBLIC_WHATSAPP="910000000000"
NEXT_PUBLIC_EMAIL="hello@example.com"
NEXT_PUBLIC_ADDRESS="Service area: Uttarakhand (address to be confirmed)"
NEXT_PUBLIC_HOURS="Mon–Sun, 9:00 am – 8:00 pm IST"

# Admin panel. Staff sign in with their own email + password (Admin → Users & roles).
# ADMIN_PASSWORD is only the one-time SETUP KEY used to create the first Super Admin.
ADMIN_PASSWORD="change-me-to-a-long-setup-key"
# Random 64-char hex (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
SESSION_SECRET="change-me-to-a-64-char-random-hex-string"

# Optional: internal lead notification webhook (Slack/Google Chat/Zapier/Make etc.)
# Receives { text } JSON. Leave empty to skip notifications.
NOTIFY_WEBHOOK_URL=""

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Admin photo uploads. On Vercel (read-only disk) connect a PUBLIC Blob store: Vercel adds
# BLOB_READ_WRITE_TOKEN and photos are stored there. Without it they go to MEDIA_DIR
# (default ./uploads) on this server's disk — back that folder up.
BLOB_READ_WRITE_TOKEN=""
MEDIA_DIR=""

# Optional: online advance payments on quote pages (Razorpay — UPI, cards, net banking).
# Dashboard → Account & Settings → API keys. Use rzp_test_… keys until the account is live.
# Webhook: https://<your-domain>/api/payments/razorpay-webhook/ (events: payment.captured, order.paid, payment.failed)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Security
# Set to 1 when the app runs behind a reverse proxy / load balancer that sets X-Real-IP or
# X-Forwarded-For (nginx: proxy_set_header X-Real-IP $remote_addr;). Without it, rate limits
# can't tell visitors apart. Leave unset only if nothing in front of the app sets these headers.
TRUST_PROXY="1"
# Separate key for encrypting stored secrets (WhatsApp token, driver licence numbers).
# Random 64-char hex (`openssl rand -hex 32`). Existing data stays readable after you add it.
ENCRYPTION_KEY=""
