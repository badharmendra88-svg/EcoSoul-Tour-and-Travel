// EcoSoul Uttarakhand Travel — data model (blueprint §10, §24.7)
// SQLite for the MVP. Arrays/objects are stored as JSON strings because
// SQLite has no native list type; see src/lib/json.ts for helpers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Destination {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  region            String // Kumaon | Garhwal
  cluster           String // e.g. "Lake & hill escapes"
  scene             String    @default("mountain") // artwork variant (fallback when no photo)
  bestFor           String? // e.g. "Families, Couples, Weekend"
  imageUrl          String? // uploaded, licensed photo (/media/...)
  imageAlt          String?
  imageCredit       String?
  summary           String
  intro             String
  bestTime          String
  howToReach        String
  suggestedDuration String
  experiences       String    @default("[]") // JSON string[]
  practical         String    @default("[]") // JSON string[]
  faqs              String    @default("[]") // JSON {q,a}[]
  seoTitle          String?
  seoDescription    String?
  status            String    @default("PUBLISHED") // DRAFT | PUBLISHED
  sortOrder         Int       @default(100)
  reviewedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  packages          Package[]
}

model Package {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  durationDays   Int
  durationLabel  String // "3 days / 2 nights"
  tripType       String // FAMILY | WEEKEND | PILGRIMAGE | NATURE | WELLNESS | CUSTOM
  audience       String
  startingPrice  Int? // null => "Price on request"
  currency       String        @default("INR")
  priceBasis     String? // per person / per couple / per vehicle ...
  season         String
  itinerary      String        @default("[]") // JSON {day,title,detail}[]
  inclusions     String        @default("[]") // JSON string[]
  exclusions     String        @default("[]") // JSON string[]
  notes          String        @default("[]") // JSON string[]
  internalNotes  String? // "must clarify before sale" — never shown publicly
  imageUrl       String?
  imageAlt       String?
  imageCredit    String?
  featured       Boolean       @default(false)
  status         String        @default("DRAFT") // DRAFT | PUBLISHED | PAUSED
  seoTitle       String?
  seoDescription String?
  sortOrder      Int           @default(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  destinations   Destination[]
}

// One lead table for every enquiry type so the team works a single queue
// (blueprint §26: route all unconfirmed requests to the same process).
model Enquiry {
  id              String         @id @default(cuid())
  ref             String         @unique // public enquiry ID, e.g. ES-261020-7KQ4
  kind            String // TRIP | PACKAGE | TRANSPORT | CONTACT
  status          String         @default("NEW")
  name            String
  phone           String?
  email           String?
  sourcePage      String?
  heardFrom       String?
  utm             String? // JSON {source,medium,campaign,term,content,landing}
  travellingFrom  String? // customer's home city, e.g. "Delhi NCR" (audience insight)

  // Trip / package
  packageSlug     String?
  destination     String?
  travelDate      String? // ISO date (yyyy-mm-dd)
  dateFlexible    Boolean        @default(false)
  adults          Int?
  children        Int?
  interests       String? // comma separated
  budgetBand      String?
  message         String?

  // Transport (§24.4)
  serviceType     String? // CAR_DRIVER | DRIVER_ONLY | LOCAL | ONE_WAY | ROUND_TRIP | AIRPORT_RAIL | GROUP
  pickup          String?
  drop            String?
  pickupTime      String? // HH:mm
  returnDate      String?
  luggage         String?
  vehicleCategory String?
  fareType        String? // FIXED_QUOTE | ESTIMATE
  arrivalRef      String? // flight/train reference (optional)
  tripDays        Int? // trip duration in days
  transmission    String? // driver-only: MANUAL | AUTOMATIC

  consent         Boolean
  consentAt       DateTime
  assignedTo      String?
  internalNotes   String?
  notifyStatus    String         @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  notifyError     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          EnquiryEvent[]
  quotes          Quote[]

  @@index([status])
  @@index([kind, createdAt])
}

// ---------- Rate card & quotations (admin estimate calculator) ----------
// All money values are whole rupees.

model VehicleRate {
  id              String   @id // matches vehicleCategories ids, e.g. SEDAN
  name            String
  example         String // e.g. "Swift Dzire or similar"
  seats           Int
  perKm           Int // outstation rate per km
  minKmPerDay     Int // minimum chargeable km per day (outstation)
  driverAllowance Int // per day
  nightHalt       Int // driver night-stay charge per night
  localPackage    Int // local package price per day
  localHours      Int      @default(8)
  localKm         Int      @default(80)
  extraHour       Int
  extraKm         Int
  oneWayPerKm     Int      @default(0) // one-way drop rate per km (covers empty return)
  transferBase    Int      @default(0) // airport/railway transfer fare incl. transferKm
  transferKm      Int      @default(40)
  active          Boolean  @default(true)
  sortOrder       Int      @default(100)
  updatedAt       DateTime @updatedAt
}

model HotelRate {
  id             String   @id // BUDGET | STANDARD | PREMIUM
  name           String
  description    String
  perRoomNight   Int // double occupancy, breakfast included
  mealsPerPerson Int // extra for dinner (MAP) per person per night
  sortOrder      Int      @default(100)
  updatedAt      DateTime @updatedAt
}

model QuoteSettings {
  id               String   @id @default("default")
  gstPct           Float
  gstLabel         String
  markupPct        Float
  markupLabel      String
  validityDays     Int
  advancePct       Int
  peakSurchargePct Int
  // One-way & transfer rules
  oneWayMinKm             Int @default(80)
  lateNightCharge         Int @default(300) // pickups/drops 10 pm – 6 am
  freeWaitMinutes         Int @default(45)
  // Driver-only (customer's own vehicle)
  driverDayRate           Int @default(1000) // local, per day
  driverOutstationDayRate Int @default(1300)
  driverDayHours          Int @default(10)
  driverOvertimeHour      Int @default(100)
  driverNightAllowance    Int @default(300) // per night away from base
  terms            String // one per line
  updatedAt        DateTime @updatedAt
}

model Quote {
  id            String    @id @default(cuid())
  token         String    @unique // unguessable public link token
  number        String    @unique // e.g. Q-261020-7KQ4
  enquiryId     String?
  enquiry       Enquiry?  @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  status        String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED
  customerName  String
  customerPhone String?
  customerEmail String?
  title         String
  tripSummary   String?
  travelDate    String?
  items         String    @default("[]") // JSON {label,qty,unit,rate}[]
  subtotal      Int
  markupPct     Float
  markupLabel   String
  markupAmount  Int
  taxPct        Float
  taxLabel      String
  taxAmount     Int
  total         Int
  advancePct    Int
  inclusions    String    @default("[]") // JSON string[]
  exclusions    String    @default("[]") // JSON string[]
  notes         String?
  terms         String    @default("[]") // JSON string[] (snapshot at save time)
  calcInput     String? // JSON calculator inputs, to reopen the estimate
  validUntil    String // yyyy-mm-dd
  sentAt        DateTime?
  sentVia       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@index([enquiryId])
}

// Advance / balance payments against a quote. Online payments come from
// Razorpay (verified by signature or webhook); UPI / bank / cash payments are
// recorded by the team after checking their bank statement.
model Payment {
  id          String    @id @default(cuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  method      String // RAZORPAY | UPI | BANK | CASH
  status      String    @default("CREATED") // CREATED | PAID | FAILED
  amount      Int // whole rupees
  orderId     String?   @unique // Razorpay order id
  paymentId   String?   @unique // Razorpay payment id
  reference   String? // UPI / bank reference for manual entries
  note        String?
  recordedBy  String? // admin name for manual entries; "razorpay" for online
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quoteId, status])
}

// ---------- Admin users & roles ----------
// role: SUPER_ADMIN | ADMIN | MANAGER (see src/lib/permissions.ts)
model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique // stored lower-case
  passwordHash String // scrypt
  role         String    @default("MANAGER")
  active       Boolean   @default(true)
  // Bumped on password change / reset / deactivation to revoke existing sessions
  tokenVersion Int       @default(1)
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Site settings & integrations (admin "Settings") ----------
// Empty contact fields fall back to the NEXT_PUBLIC_* env values.
model SiteSettings {
  id                  String    @id @default("default")
  // Business contact
  phone               String?
  whatsapp            String?
  email               String?
  address             String?
  hours               String?
  // WhatsApp on the website
  whatsappButton      Boolean   @default(true)
  whatsappGreeting    String?
  // WhatsApp Business Cloud API (Meta)
  waApiEnabled        Boolean   @default(false)
  waPhoneNumberId     String?
  waBusinessAccountId String?
  waAccessTokenEnc    String? // AES-256-GCM encrypted, never sent to the browser
  waApiVersion        String    @default("v21.0")
  waQuoteTemplate     String? // approved template with a DOCUMENT header
  waTemplateLang      String    @default("en")
  waLastTestAt        DateTime?
  waLastTestOk        Boolean?
  waLastTestResult    String?
  // Social profiles
  instagram           String?
  facebook            String?
  youtube             String?
  twitter             String?
  linkedin            String?
  googleBusiness      String?
  tripadvisor         String?
  // Tracking & notifications
  gaId                String?
  metaPixelId         String?
  googleVerification  String?
  notifyWebhookUrl    String?
  // Homepage hero photo
  heroImageUrl        String?
  heroImageAlt        String?
  // Homepage "Choose your travel service" card photos
  serviceToursImageUrl  String?
  serviceToursImageAlt  String?
  serviceTaxiImageUrl   String?
  serviceTaxiImageAlt   String?
  serviceDriverImageUrl String?
  serviceDriverImageAlt String?
  serviceCustomImageUrl String?
  serviceCustomImageAlt String?
  // Business identity (trust)
  legalName           String?
  gstin               String?
  tourismRegNo        String?
  emergencyPhone      String?
  // Payments — UPI shown on quote pages (Razorpay keys live in .env)
  upiId               String?
  upiPayeeName        String?
  updatedAt           DateTime  @updatedAt
}

// Customer reviews — published only with the customer's recorded permission
model Review {
  id          String   @id @default(cuid())
  name        String // as the customer agreed to be shown, e.g. "Priya S."
  place       String? // e.g. "Delhi"
  tripLabel   String? // e.g. "Nainital family trip, May 2026"
  text        String
  rating      Int? // 1-5, optional
  consentNote String // how/when permission was given
  published   Boolean  @default(false)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Audit trail for status / assignment / note changes (§10 access rule, TR-10)
model EnquiryEvent {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  actor     String
  action    String
  detail    String?

  @@index([enquiryId, at])
}

// ---------- Driver partners (public registration + admin verification) ----------
// status: APPLIED | UNDER_REVIEW | VERIFIED | ACTIVE | INACTIVE | REJECTED
model DriverPartner {
  id                  String        @id @default(cuid())
  ref                 String        @unique // e.g. DR-261020-7KQ4
  status              String        @default("APPLIED")
  name                String
  phone               String
  email               String?
  baseLocation        String
  serviceAreas        String // comma separated
  experienceYears     Int
  hillExperienceYears Int?
  languages           String? // comma separated
  licenceType         String // LMV | LMV_TR | HMV
  licenceNumberEnc    String // AES-256-GCM encrypted
  licenceLast4        String
  licenceExpiry       String // yyyy-mm-dd (as declared; re-checked by staff)
  partnerType         String // DRIVER_ONLY | WITH_VEHICLE
  vehicleCategory     String?
  vehicleModel        String?
  vehicleRegNo        String?
  vehicleSeats        Int?
  commercialPermit    String? // YES | NO | APPLIED
  availability        String // FULL_TIME | PART_TIME | WEEKENDS | SEASONAL
  expectedDailyRate   Int?
  message             String?
  heardFrom           String?
  consentAt           DateTime

  // Staff verification (blueprint §24.3) — checked in person, never published
  licenceChecked      Boolean       @default(false)
  idChecked           Boolean       @default(false)
  policeVerified      Boolean       @default(false)
  vehicleDocsChecked  Boolean       @default(false)
  agreementSigned     Boolean       @default(false)
  verifiedAt          DateTime?
  verifiedBy          String?
  insuranceExpiry     String?
  permitExpiry        String?
  fitnessExpiry       String?
  pucExpiry           String?
  internalNotes       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  events              DriverEvent[]

  @@index([status])
  @@index([phone])
}

model DriverEvent {
  id       String        @id @default(cuid())
  driverId String
  driver   DriverPartner @relation(fields: [driverId], references: [id], onDelete: Cascade)
  at       DateTime      @default(now())
  actor    String
  action   String
  detail   String?

  @@index([driverId, at])
}
